# --- Convolve configuration ---------------------------------------------
CONVOLVE_ENV=development
CONVOLVE_HOST=0.0.0.0
CONVOLVE_PORT=8000
CONVOLVE_LOG_LEVEL=INFO

# --- Storage -------------------------------------------------------------
CONVOLVE_DATABASE_URL=postgresql+asyncpg://convolve:convolve@localhost:5432/convolve
# For a quick local run without Postgres, use:
# CONVOLVE_DATABASE_URL=sqlite+aiosqlite:///./convolve.db

CONVOLVE_REDIS_URL=redis://localhost:6379/0
CONVOLVE_STATE_TTL_SECONDS=3600

# --- Abstention policy ---------------------------------------------------
CONVOLVE_DEFAULT_THRESHOLD=0.70
CONVOLVE_MAX_STEPS=12
CONVOLVE_DEFAULT_BUDGET=0.50
CONVOLVE_COST_KNEE=0.50

# --- Model artefacts -----------------------------------------------------
CONVOLVE_EVALUATOR_MODEL_PATH=artifacts/evaluator.joblib
CONVOLVE_DISTILLER_CHECKPOINT=artifacts/distiller.pt

# --- Trajectory logging --------------------------------------------------
CONVOLVE_TRAJECTORY_DIR=data/trajectories

# --- Playbook retrieval --------------------------------------------------
CONVOLVE_PLAYBOOK_TOP_K=2
